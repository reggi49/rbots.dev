# Git ignore for rbot (React Native TypeScript project)
# Keeps build artifacts, node_modules, native caches, IDE files, and large model files out of git.

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-lock.yaml

# React Native / Metro
.expo/
.expo-shared/
android/app/build/
android/build/
android/.gradle/
ios/Pods/
ios/build/
*.keystore
*.jks

# Xcode
*.xcworkspace
*.xcuserstate
DerivedData/

# Gradle local properties
**/local.properties

# Misc build
dist/
build/
*.log

# IDEs
.vscode/
.idea/
*.iml

# OS files
.DS_Store

# Environment
.env
.env.*.local

# Temporary template/backups
rbottmp/
rbottmp.backup/
rbottmp.orig/

# Large model artifacts (do NOT commit binary model files here)
models/*.gguf
models/*.bin
models/*.onnx
models/*.pt

# Optional: lockfiles may be committed depending on workflow
# package-lock.json

# Python
__pycache__/
*.pyc
.venv/
